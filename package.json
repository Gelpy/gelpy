{
  "name": "gelpy-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Public engineering documentation for Gelpy.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "docusaurus start",
    "start:es": "docusaurus start --locale es",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "check:public": "node scripts/check-public.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-include=scripts/** --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 \"tests/**/*.test.mjs\"",
    "check:brand": "node scripts/check-brand.mjs",
    "check:public:live": "node scripts/check-public.mjs --live https://docs.gelpy.app",
    "wiki:build": "node scripts/build-wiki.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc",
    "cf:build": "node scripts/workers-builds.mjs build",
    "cf:deploy": "node scripts/workers-builds.mjs deploy",
    "cf:preview": "node scripts/workers-builds.mjs preview",
    "ci:local": "npm audit --audit-level=high && npm test && npm run check:public && npm run check:brand && node scripts/build-wiki.mjs && npm run build && npm run deploy:dry-run",
    "ci:evidence": "node scripts/ci-evidence.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "serialize-javascript": "^7.1.4",
    "tinypool": "^2.2.0",
    "uuid": "^11.1.1"
  },
  "optionalDependencies": {
    "@gelpy/design-system": "0.1.0"
  },
  "devDependencies": {
    "wrangler": "4.156.2"
  }
}
